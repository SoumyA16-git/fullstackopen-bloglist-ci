{
  "name": "fullstackopen-bloglist-ci",
  "version": "1.0.0",
  "description": "Full Stack Open Part 11 - Bloglist CI/CD Pipeline",
  "main": "index.js",
  "scripts": {
    "test": "cross-env NODE_ENV=test node --test --test-concurrency=1",
    "start": "cross-env NODE_ENV=production node index.js",
    "dev": "cross-env NODE_ENV=development node --watch index.js",
    "install:all": "npm install && cd frontend && npm install",
    "test:frontend": "npm --prefix frontend test -- --run",
    "build:frontend": "npm --prefix frontend run build"
  },
  "keywords": [
    "fullstack-open",
    "ci-cd",
    "github-actions"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.1"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "supertest": "^7.2.2"
  }
}
